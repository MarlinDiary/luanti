+void GameFormSpec::courseClose()
+{
+	if (!m_formspec || coursePaused()) return;
+	SEvent event{}; event.EventType = EET_KEY_INPUT_EVENT;
+	event.KeyInput.Key = KEY_ESCAPE; event.KeyInput.PressedDown = true;
+	m_formspec->OnEvent(event); ++m_course_form_revision;
+}
+bool GameFormSpec::coursePaused() const { return g_menumgr.pausesGame(); }
+uint64_t GameFormSpec::courseFormId() const
+{
+	return m_formspec && m_formspec->getParent() ? m_course_form_revision : 0;
+}
+std::vector<GUIInventoryList *> GameFormSpec::courseLists() const
+{
+	if (!courseFormId() || coursePaused()) return {};
+	std::vector<GUIInventoryList *> result;
+	for (auto *list : m_formspec->courseLists()) if (list->isTrulyVisible()) result.push_back(list);
+	return result;
+}
